# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/my_library?schema=public

# JWT Configuration
JWT_SECRET=replace_with_a_secure_random_secret_in_production
JWT_EXPIRES_IN=24h

# Initial Database Seed Configuration (Required for seed command)
SEED_OWNER_USERNAME=owner
SEED_OWNER_PASSWORD=OwnerPassword123!

SEED_DEVELOPER_USERNAME=developer
SEED_DEVELOPER_PASSWORD=DeveloperPassword123!
